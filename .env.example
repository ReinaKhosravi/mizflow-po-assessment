# Application: only project URL + publishable key (local legacy anon JWT also supported).
# Missing/invalid values fail closed to /setup. Never use a service-role/secret key here.
NEXT_PUBLIC_SUPABASE_URL=https://qfyiyqjogfagevxzdgol.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional DEVELOPMENT SEED ONLY. Read by scripts/seed-demo.mjs, never the app.
# The seed requires explicit target confirmation for the named Cloud development project.
# Prefer keeping administrative values in separate ignored .env.seed.local; never deploy them.
MIZFLOW_DEMO_SEED=
MIZFLOW_DEMO_DATABASE_URL=
MIZFLOW_SEED_AUTH_KEY=
MIZFLOW_SEED_KEY_ROTATED=
MIZFLOW_CONFIRMED_PROJECT_REF=
MIZFLOW_DEMO_PASSWORD=

# Optional real Supabase browser tests, only in a local seeded development stack.
# Set MIZFLOW_E2E_AUTH=1 as a shell variable to include the authenticated browser test.
MIZFLOW_E2E_AUTH=

# Read-only Cloud schema preflight only (prefer ignored .env.admin.local).
MIZFLOW_ADMIN_DATABASE_URL=
