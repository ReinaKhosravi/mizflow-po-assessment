{
  "name": "mizflow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node --env-file-if-exists=.env.test.local node_modules/@playwright/test/cli.js test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:db": "node scripts/test-database.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:migrate": "supabase migration up --local",
    "db:seed": "node --env-file=.env.seed.local scripts/seed-demo.mjs",
    "db:check:cloud": "node --env-file=.env.admin.local scripts/cloud-preflight.mjs",
    "db:seed:cloud": "node --env-file=.env.admin.local --env-file=.env.seed.local scripts/seed-demo.mjs",
    "test:supabase": "node --env-file-if-exists=.env.test.local --test --test-concurrency=1 tests/supabase/security.test.mjs tests/supabase/workflow.test.mjs",
    "db:demo:workflow": "node --env-file=.env.admin.local --env-file=.env.seed.local scripts/workflow-demo.mjs",
    "db:demo:reset": "MIZFLOW_DEMO_RESET=table12-only node --env-file=.env.admin.local --env-file=.env.seed.local scripts/workflow-demo.mjs"
  },
  "dependencies": {
    "@fontsource/vazirmatn": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "supabase": "^2.122.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
